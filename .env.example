# 이 파일은 참고용이다. docker-compose.yml 이 모든 값에 기본값을 갖고 있어서
# .env 없이 `docker compose up -d --build` 만 해도 그대로 뜬다.
# 포트가 겹치거나 값을 바꾸고 싶을 때만 `cp .env.example .env` 로 복사해 고친다.

# PostgreSQL
POSTGRES_DB=business
POSTGRES_USER=business
POSTGRES_PASSWORD=business

# 노출 포트
FRONTEND_PORT=5173
BACKEND_PORT=8081
# PostgreSQL은 15432로 연다. 5432는 로컬 PostgreSQL과 겹치기 쉬워서 피한다.
# 15432마저 겹치면 여기서 바꾸고, 백엔드에는 DB_URL 로 같은 포트를 알려 준다.
POSTGRES_PORT=15432

# JWT 서명 키 — 32바이트 이상이어야 한다. 실제 배포에서는 반드시 바꾼다.
JWT_SECRET=bizxray-local-demo-signing-key-change-me-0123456789

# 시연·평가용 기본 계정
DEMO_SEED_EMAIL=kim@company.com
DEMO_SEED_PASSWORD=logic1234
