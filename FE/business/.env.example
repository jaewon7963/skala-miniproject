# 실제 백엔드 연동 시 VITE_USE_MOCK=false 로만 바꾸면 됩니다.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8081
VITE_MOCK_LATENCY=350

# ─── LLM (검토 화면 챗봇) ─────────────────────────────────────
# 실제 키는 여기에 쓰지 말고 .env.local 에 씁니다. (.env.local 은 커밋되지 않습니다)
VITE_LLM_ENABLED=false
VITE_LLM_DIALECT=openai
VITE_LLM_BASE_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=
VITE_LLM_TEMPERATURE=0.2
VITE_LLM_MAX_TOKENS=1024
VITE_LLM_HISTORY_TURNS=12
